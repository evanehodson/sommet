# Copy this file to .env and fill in your real values. Never commit .env.

# Local development: leave DATABASE_URL unset to fall back to a local SQLite file.
# DATABASE_URL=sqlite:///./local_dev.db

# Production (Neon Postgres): swap "postgresql://" -> "postgresql+psycopg://"
# so SQLModel uses the psycopg driver.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Comma-separated CORS origins the browser front-end is allowed to call.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Shared admin key for the registrant-listing endpoint. Send it as X-Admin-Key.
ADMIN_API_KEY=change-me